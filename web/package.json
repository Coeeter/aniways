{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"ui:add": "bun x shadcn-svelte@latest add",
		"postui:add": "bun format",
		"openapi": "openapi-typescript ../docs/openapi.yaml -o ./src/lib/api/openapi.ts",
		"postopenapi": "prettier --write ./src/lib/api/"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/nprogress": "^0.2.3",
		"bits-ui": "^2.11.0",
		"clsx": "^2.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"formsnap": "^2.0.1",
		"globals": "^16.0.0",
		"mode-watcher": "^1.0.8",
		"openapi-typescript": "^7.9.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.26.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"arktype": "^2.1.21",
		"artplayer": "^5.3.0",
		"artplayer-plugin-hls-control": "^1.0.1",
		"date-fns": "^4.1.0",
		"hls.js": "^1.6.12",
		"lucide-svelte": "^0.539.0",
		"nprogress": "^0.2.0",
		"openapi-fetch": "^0.14.0",
		"posthog-js": "^1.352.0",
		"posthog-node": "^5.24.17",
		"runed": "^0.35.1"
	}
}
