{
  "$schema": "https://raw.githubusercontent.com/Coeeter/ntmux/refs/heads/main/schema.json",
  "sessions": [
    {
      "name": "aniways",
      "default": true,
      "windows": [
        {
          "name": "editor",
          "cmd": "nvim ."
        },
        {
          "name": "terminal",
          "cmd": "make dev-docker-up"
        },
        {
          "name": "api",
          "cmd": "make dev-api"
        },
        {
          "name": "worker",
          "cmd": "make dev-worker"
        },
        {
          "name": "frontend",
          "cmd": "bun run dev",
          "dir": "./web"
        }
      ]
    }
  ]
}
